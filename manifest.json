{
  "schemaVersion": 1,
  "id": "io.github.jestemkarol.bing-wallpaper",
  "name": "Bing Wallpaper",
  "version": "1.0.2",
  "author": "Karol Wylizinski",
  "license": "MIT",
  "description": "Syncs your background to Bing's image of the day, keeps a browsable library of the last days, and survives theme switches.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Bing Wallpaper",
    "description": "Today's Bing image of the day with its title and copyright, and one click to make it your background.",
    "category": "Appearance",
    "aliases": [
      "bing",
      "wallpaper",
      "background"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "market": "auto",
      "resolution": "UHD",
      "autoApply": true,
      "reapplyAfterThemeChange": true,
      "randomFromLibrary": false,
      "keepDays": 30,
      "notify": false
    },
    "schema": [
      {
        "key": "market",
        "type": "enum",
        "label": "Region",
        "options": [
          "auto",
          "en-US",
          "en-GB",
          "en-AU",
          "en-CA",
          "en-IN",
          "de-DE",
          "fr-FR",
          "fr-CA",
          "es-ES",
          "it-IT",
          "pt-BR",
          "nl-NL",
          "pl-PL",
          "ja-JP",
          "zh-CN",
          "ko-KR"
        ],
        "defaultValue": "auto",
        "description": "Bing serves a different image per region. 'auto' follows your system locale, falling back to en-US."
      },
      {
        "key": "resolution",
        "type": "enum",
        "label": "Resolution",
        "options": [
          "UHD",
          "1920x1200",
          "1920x1080",
          "1366x768",
          "1280x720"
        ],
        "defaultValue": "UHD",
        "description": "UHD is roughly 4 MB per image; the smaller sizes are a few hundred kilobytes."
      },
      {
        "key": "autoApply",
        "type": "boolean",
        "label": "Apply new images",
        "defaultValue": true,
        "description": "New images become your background as soon as they download."
      },
      {
        "key": "reapplyAfterThemeChange",
        "type": "boolean",
        "label": "Keep after theme switch",
        "defaultValue": true,
        "description": "Omarchy resets the background when the theme changes."
      },
      {
        "key": "randomFromLibrary",
        "type": "boolean",
        "label": "Shuffle the library",
        "defaultValue": false,
        "description": "Pick a random downloaded image instead of today's."
      },
      {
        "key": "keepDays",
        "type": "integer",
        "label": "Keep for (days)",
        "min": 1,
        "max": 365,
        "step": 1,
        "defaultValue": 30
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Notify on change",
        "defaultValue": false
      }
    ]
  }
}
