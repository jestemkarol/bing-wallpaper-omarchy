#!/bin/bash

# Fetches Bing's image-of-the-day metadata, downloads any images the local
# library is missing, prunes old ones, and rewrites state.json.
#
# Runs standalone — Service.qml only shells out to it. Everything it needs to
# say back to the shell goes to stdout as one JSON object, so the QML side
# never has to parse human-readable output.
#
# Exit codes: 0 success · 1 usage/environment error · 2 fetch failure

set -uo pipefail

DEFAULT_DIR="$HOME/.local/share/omarchy-bing-wallpaper"

# Bing answers curl's default User-Agent with a "Browser Not Supported" HTML
# page instead of JSON, so every request here presents a browser one.
USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"

MARKET="en-US"
RESOLUTION="UHD"
KEEP_DAYS=30
DATA_DIR="$DEFAULT_DIR"
FIXTURE=""
DRY_RUN=0
COUNT=15

# Bing serves eight days per request and pages with idx. idx=7 returns days
# 7-14; anything past that clamps to the same window, so fifteen distinct days
# is the whole archive and two requests reach all of it.
MAX_ARCHIVE_DAYS=15
PAGE_SIZE=8

# Bing stopped publishing some legacy sizes for individual images. When the
# requested one 404s we fall back down this list rather than leaving a gap in
# the library.
RESOLUTION_FALLBACKS=("UHD" "1920x1200" "1920x1080" "1366x768" "1280x720")

usage() {
  cat <<USAGE
Usage: bing-wallpaper-sync [options]

  --market <mkt>       Bing market, e.g. en-US, de-DE, ja-JP (default: en-US)
  --resolution <res>   UHD | 1920x1200 | 1920x1080 | 1366x768 | 1280x720 (default: UHD)
  --keep <days>        Retain downloaded images for this many days (default: 30)
  --dir <path>         Library directory (default: $DEFAULT_DIR)
  --count <n>          How many days of metadata to request, 1-15 (default: 15).
                       Fifteen is everything Bing's archive holds.
  --fixture <file>     Read the API response from a file instead of the network
  --dry-run            Resolve everything but download nothing and write nothing
  -h, --help           This text

Prints a JSON summary on stdout.
USAGE
}

fail() {
  echo "bing-wallpaper-sync: $*" >&2
  exit "${2:-1}"
}

# Called as `need_value "$@"` from a value-taking branch, so $1 is the flag and
# $2 is whatever followed it. A flag left last on the command line has nothing
# to shift past: `shift 2` then fails, and since this script runs without -e the
# failure was ignored and the loop spun on the same argument forever.
need_value() {
  (( $# >= 2 )) || fail "$1 requires a value"
}

while (( $# > 0 )); do
  case "$1" in
    --market)     need_value "$@"; MARKET="$2"; shift 2 ;;
    --resolution) need_value "$@"; RESOLUTION="$2"; shift 2 ;;
    --keep)       need_value "$@"; KEEP_DAYS="$2"; shift 2 ;;
    --dir)        need_value "$@"; DATA_DIR="$2"; shift 2 ;;
    --count)      need_value "$@"; COUNT="$2"; shift 2 ;;
    --fixture)    need_value "$@"; FIXTURE="$2"; shift 2 ;;
    --dry-run)    DRY_RUN=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    *)            usage >&2; fail "unknown option: $1" ;;
  esac
done

command -v jq >/dev/null || fail "jq is required"
command -v curl >/dev/null || fail "curl is required"

[[ $MARKET =~ ^[a-z]{2}-[A-Z]{2}$ ]] || fail "invalid market: $MARKET"
[[ $RESOLUTION =~ ^(UHD|[0-9]{3,4}x[0-9]{3,4})$ ]] || fail "invalid resolution: $RESOLUTION"
[[ $KEEP_DAYS =~ ^[0-9]+$ ]] && (( KEEP_DAYS >= 1 )) || fail "invalid --keep: $KEEP_DAYS"
[[ $COUNT =~ ^[0-9]+$ ]] && (( COUNT >= 1 && COUNT <= MAX_ARCHIVE_DAYS )) || fail "invalid --count: $COUNT"

IMAGES_DIR="$DATA_DIR/images"
STATE_FILE="$DATA_DIR/state.json"

# ------------------------------------------------------------------ metadata

# CURL_PINNED keeps every request on https. -L follows redirects, which with
# nothing restricting it would let a redirect walk the transfer to another
# scheme, or keep it bouncing. --proto pins the URL we ask for, --proto-redir
# pins every hop it is sent on to, and --max-redirs caps the chain. Three hops
# is more than Bing has ever needed.
CURL_PINNED=(--proto '=https' --proto-redir '=https' --max-redirs 3)

fetch_page() {
  local idx="$1"
  curl -fsSL "${CURL_PINNED[@]}" --max-time 20 --retry 2 --retry-delay 1 \
    -A "$USER_AGENT" -H 'Accept: application/json' \
    "https://www.bing.com/HPImageArchive.aspx?format=js&idx=$idx&n=$PAGE_SIZE&mkt=$MARKET"
}

response=""
if [[ -n $FIXTURE ]]; then
  [[ -f $FIXTURE ]] || fail "fixture not found: $FIXTURE"
  response=$(cat "$FIXTURE")
else
  response=$(fetch_page 0) || fail "could not reach the Bing image archive" 2

  # The second page overlaps the first by a day; merging on startdate drops the
  # duplicate. Only fetched when more than one page was asked for, so the
  # common daily check stays a single request.
  if (( COUNT > PAGE_SIZE )); then
    if older=$(fetch_page "$PAGE_SIZE"); then
      response=$(jq -c -n --argjson a "$response" --argjson b "$older" '
        { images: (($a.images // []) + ($b.images // []))
            | unique_by(.startdate)
            | sort_by(.startdate)
            | reverse }')
    fi
    # A failed second page is not fatal: the newest eight days are what
    # matters, and the older ones are already on disk after the first run.
  fi
fi

jq -e '(.images | type) == "array" and (.images | length) > 0' <<<"$response" >/dev/null 2>&1 \
  || fail "unexpected response from the Bing image archive" 2

# Honour --count after paging, so a smaller request is not widened by the page
# size and the fixture path is bounded the same way the network path is.
response=$(jq -c --argjson n "$COUNT" '.images |= (sort_by(.startdate) | reverse | .[0:$n])' <<<"$response")

# Normalize the API payload into our own entry shape. urlbase arrives as a
# site-relative path ("/th?id=OHR.Foo_EN-US123"); the download URL is that plus
# "_<resolution>.jpg". `title` is missing on some markets, so fall back to the
# copyright line's leading clause.
#
# The host is pinned by concatenation, and concatenation alone does not hold
# it: a urlbase of "@evil.example/x" builds
# "https://www.bing.com@evil.example/x", where the pinned name has become
# userinfo and the request goes to evil.example instead. A backslash, a
# control character or a stray space can likewise be read one way here and
# another by a URL parser. Rather than name each of those, `path_ok` allows
# only what a genuine urlbase is made of: a leading slash, then letters,
# digits and / ? = . _ - & % . The second character may not be another slash,
# so nothing that reads as protocol-relative gets through either. \A and \z
# rather than ^ and $, so a trailing newline cannot slip past the anchor. An
# entry that fails is dropped, not fetched.
#
# Omarchy renders the background's basename as its display name (see
# omarchy-theme-bg-current), so the filename carries the image title rather
# than the market and size — "Geometry Of A Star City" reads better than
# "En US UHD". A title that slugs to nothing — punctuation or emoji only —
# falls back to the date alone.
remote=$(jq -c --arg market "$MARKET" --arg res "$RESOLUTION" --arg dir "$IMAGES_DIR" '
  # Keeps Unicode letters and digits, so ja-JP, zh-CN, ko-KR and the other
  # non-Latin markets get a readable name instead of a bare date. \p{L}\p{N}
  # is deliberately narrow: separators, shell metacharacters, control
  # characters and the format characters (Cf) that carry bidi overrides all
  # fall outside it and collapse to a dash, and the leading-dash strip keeps
  # a title from ever looking like an option. .[0:48] counts codepoints, so
  # the byte cap that follows is what actually bounds the filename — a
  # 48-codepoint CJK slug is 144 bytes.
  def slug:
    ascii_downcase
    | gsub("[^\\p{L}\\p{N}]+"; "-")
    | gsub("^-+|-+$"; "")
    | .[0:48]
    | until(utf8bytelength <= 120; .[0:-1])
    | gsub("-+$"; "");

  def path_ok: test("\\A/[A-Za-z0-9?=._&%-][A-Za-z0-9/?=._&%-]*\\z");

  [ .images[]
    | (.urlbase // "") as $base
    | select($base != "")
    | select($base | path_ok)
    | (.copyright // "") as $copy
    | (.startdate // "") as $date
    | (if (.title // "") != "" then .title else ($copy | split(" (©")[0]) end) as $title
    | ($title | slug) as $slug
    | {
        date: $date,
        fullStartDate: (.fullstartdate // ""),
        endDate: (.enddate // ""),
        title: $title,
        copyright: $copy,
        copyrightLink: ((.copyrightlink // "") | if test("\\Ahttps?://[A-Za-z0-9/?=._&%:+#@~-]+\\z"; "i") then . else "" end),
        urlBase: $base,
        market: $market,
        resolution: $res,
        url: ("https://www.bing.com" + $base + "_" + $res + ".jpg"),
        file: ($dir + "/" + $date + (if $slug != "" then "-" + $slug else "" end) + ".jpg")
      }
    | select(.date != "")
  ]' <<<"$response") || fail "could not parse the Bing image archive response" 2

# ------------------------------------------------------------------ download

# Entries older than the API window are kept as long as their file survives, so
# the library the panel browses is bounded by --keep rather than by Bing's
# eight-day archive.
previous='[]'
recovered=0
if [[ -f $STATE_FILE ]]; then
  # jq exiting 0 is not proof the read is usable: an empty or whitespace-only
  # state.json makes it print nothing at all, and one whose .entries is not an
  # array makes it print a non-array. Either value breaks the merge below, and
  # the run then downloads the whole archive only to prune every file it just
  # fetched. So only a real array is taken, head bounds a file that somehow
  # holds more than one document to the single value --argjson accepts, and
  # anything else starts from an empty library the next run refills.
  previous=$(jq -c 'if (.entries | type) == "array" then .entries else empty end' \
    "$STATE_FILE" 2>/dev/null | head -n 1)
  if [[ -z $previous ]]; then
    previous='[]'
    recovered=1
    echo "bing-wallpaper-sync: $STATE_FILE is unusable, rebuilding the library from scratch" >&2
  fi
fi

# The filename no longer encodes market and size, so "do we already have this
# day?" is answered by what the stored entry was fetched at, not by the path.
have_current() {
  local date="$1" file="$2"
  [[ -s $file ]] || return 1
  jq -e --arg d "$date" --arg m "$MARKET" --arg r "$RESOLUTION" --arg f "$file" '
    any(.[]; .date == $d and .market == $m and .resolution == $r and .file == $f)' \
    <<<"$previous" >/dev/null 2>&1
}

# A JPEG opens with the SOI marker FF D8 and then the FF that begins its first
# segment. "Did we get anything at all" was the old test, and it let through
# every 200 that is not an image: an HTML error page, a redirect landing page,
# a text file, a transfer cut short before a single byte of image data. Any of
# those would be saved under a .jpg name, recorded in state.json and, with
# autoApply on, handed to the background setter.
is_jpeg() {
  local magic
  magic=$(od -An -tx1 -N3 <"$1" 2>/dev/null | tr -d ' \n')
  [[ $magic == ffd8ff ]]
}

# Every path that promotes a downloaded file goes through here, the requested
# resolution and each fallback size alike, so the check below covers all of
# them. A response that is not a JPEG is discarded and reported as a failure,
# the same as a transport error.
download() {
  local url="$1" target="$2"
  local tmp="$target.part.$$"
  # Written to a temp file first so a killed shell or a half-finished transfer
  # can never leave a truncated JPEG that the background renderer then tries
  # to draw.
  if curl -fsSL "${CURL_PINNED[@]}" \
       --max-time 120 --retry 2 --retry-delay 2 -A "$USER_AGENT" -o "$tmp" "$url"; then
    if is_jpeg "$tmp"; then
      mv -f "$tmp" "$target"
      return 0
    fi
  fi
  rm -f "$tmp"
  return 1
}

downloaded=0
failed=0
resolved="$remote"

if (( ! DRY_RUN )); then
  mkdir -p "$IMAGES_DIR" || fail "could not create $IMAGES_DIR"

  while IFS=$'\t' read -r date url file; do
    [[ -n $date ]] || continue
    have_current "$date" "$file" && continue

    if download "$url" "$file"; then
      downloaded=$((downloaded + 1))
      continue
    fi

    # Requested size unavailable for this image — walk down to a smaller one
    # and record whichever actually landed, so state.json never points at a
    # file that is not there.
    got=""
    for alt in "${RESOLUTION_FALLBACKS[@]}"; do
      [[ $alt == "$RESOLUTION" ]] && continue
      alt_url="${url%_$RESOLUTION.jpg}_$alt.jpg"
      if download "$alt_url" "$file"; then
        got="$alt"
        downloaded=$((downloaded + 1))
        break
      fi
    done

    if [[ -n $got ]]; then
      resolved=$(jq -c --arg date "$date" --arg res "$got" '
        map(if .date == $date then
              .resolution = $res
              | .url = ((.url | sub("_[^_]+\\.jpg$"; "")) + "_" + $res + ".jpg")
            else . end)' <<<"$resolved")
    else
      failed=$((failed + 1))
    fi
  done < <(jq -r '.[] | [.date, .url, .file] | @tsv' <<<"$remote")
fi

# --------------------------------------------------------------------- state


cutoff=$(date -d "-$KEEP_DAYS days" +%Y%m%d)

merged=$(jq -c -n \
  --argjson remote "$resolved" \
  --argjson previous "$previous" \
  --arg cutoff "$cutoff" '
  ($previous + $remote)
  | group_by(.date)
  | map(.[-1])                      # a fresh entry wins over the stored one
  | map(select(.date >= $cutoff))
  | sort_by(.date)
  | reverse')

pruned=0
if (( ! DRY_RUN )); then
  # Drop entries whose file vanished, and delete files no surviving entry
  # claims. Doing both keeps disk and state.json from drifting apart.
  present=$(jq -c 'map(select(.file != null))' <<<"$merged")
  kept='[]'
  while IFS= read -r entry; do
    [[ -n $entry ]] || continue
    file=$(jq -r '.file' <<<"$entry")
    [[ -s $file ]] || continue
    kept=$(jq -c --argjson e "$entry" '. + [$e]' <<<"$kept")
  done < <(jq -c '.[]' <<<"$present")
  merged="$kept"

  if [[ -d $IMAGES_DIR ]]; then
    while IFS= read -r file; do
      [[ -n $file ]] || continue
      if ! jq -e --arg f "$file" 'any(.[]; .file == $f)' <<<"$merged" >/dev/null; then
        rm -f -- "$file" && pruned=$((pruned + 1))
      fi
    done < <(find "$IMAGES_DIR" -maxdepth 1 -type f -name '*.jpg' 2>/dev/null)
  fi
fi

state=$(jq -n \
  --argjson entries "$merged" \
  --arg market "$MARKET" \
  --arg resolution "$RESOLUTION" \
  --argjson keepDays "$KEEP_DAYS" \
  --argjson fetchedAt "$(date +%s)" '
  {
    version: 1,
    market: $market,
    resolution: $resolution,
    keepDays: $keepDays,
    fetchedAt: $fetchedAt,
    entries: $entries
  }')

if (( ! DRY_RUN )); then
  mkdir -p "$DATA_DIR"
  tmp_state="$STATE_FILE.tmp.$$"
  printf '%s\n' "$state" > "$tmp_state" && mv -f "$tmp_state" "$STATE_FILE" \
    || { rm -f "$tmp_state"; fail "could not write $STATE_FILE"; }
fi

jq -n \
  --argjson downloaded "$downloaded" \
  --argjson failed "$failed" \
  --argjson pruned "$pruned" \
  --argjson dryRun "$DRY_RUN" \
  --argjson recovered "$recovered" \
  --argjson state "$state" '
  {
    ok: ($failed == 0),
    downloaded: $downloaded,
    failed: $failed,
    pruned: $pruned,
    dryRun: ($dryRun == 1),
    recoveredState: ($recovered == 1),
    stateFile: null,
    today: ($state.entries[0] // null),
    count: ($state.entries | length)
  }' | jq -c --arg stateFile "$STATE_FILE" '.stateFile = $stateFile'

(( failed == 0 )) || exit 2
exit 0
